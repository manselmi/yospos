{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": null
  },
  "packageRules": [
    {
      "groupName": "all packages",
      "groupSlug": "all-packages"
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "matchManagers": [
        "pep621"
      ],
      "enabled": false
    }
  ],
  "platformCommit": "enabled",
  "separateMajorMinor": false
}
